    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.3.1",
    "p-limit": "7.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15"
