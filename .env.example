# Copy to .env:  cp .env.example .env
# Safe local defaults only. Never put real credentials in this file.
# docker compose overrides NODE_ENV, SMTP_HOST, SMTP_PORT and TRUST_PROXY_HOPS for containers.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (0 = trust none).
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to POST (CSRF defence). :8080 = docker, :5173 = vite dev.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Serve OpenAPI docs at /api/v1/docs.
API_DOCS_ENABLED=true

# --- Product data source -------------------------------------------------------
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_MAX_CONCURRENCY=5
# Hosts product images may be served from (https only).
IMAGE_HOST_ALLOWLIST=fakestoreapi.com
CACHE_TTL_SECONDS=300
# The entrepreneur's chosen "top rated" products for the home page, in display order (max 5 shown).
FEATURED_PRODUCT_IDS=1,5,9,14,18

# --- Rate limits (per client IP) -----------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_ENQUIRY_PER_MINUTE=5

# --- Email ---------------------------------------------------------------------
SALES_INBOX=sales@example.com
MAIL_FROM=catalogue@example.com
# Local: Mailpit (no auth, no TLS). Production: e.g. AWS SES SMTP on 587 with SMTP_REQUIRE_TLS=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=

# --- Docker compose only ---------------------------------------------------------
# Host port for the web app (default 8080). If you change it, add http://localhost:<port>
# to ALLOWED_ORIGINS or enquiry submissions will be rejected with 403.
WEB_PORT=8080
